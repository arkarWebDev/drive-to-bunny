# ------------------------------------------------------------------
# Telegram
# ------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone who can reach the bot.
TELEGRAM_ALLOWED_USER_IDS=

# ------------------------------------------------------------------
# Bunny Stream (video hosting / encoding, not Bunny Storage)
# ------------------------------------------------------------------
# Video Library ID (a number) - see bunny.net dashboard -> Stream -> Library
BUNNY_STREAM_LIBRARY_ID=
# Library API key - Stream -> Library -> API Keys
BUNNY_STREAM_API_KEY=
# Optional: GUID of a collection the videos should be added to
BUNNY_STREAM_COLLECTION_ID=

# ------------------------------------------------------------------
# Tuning (optional)
# ------------------------------------------------------------------
# Video file extensions to download and upload (comma-separated)
ALLOWED_EXTENSIONS=mov,mp4,m4v,avi,mkv
# How many times a failed upload chunk is retried before aborting
MAX_UPLOAD_RETRIES=5
# Skip files larger than this (in MB). 0 = unlimited.
MAX_FILE_SIZE_MB=10240
# TUS resumable upload chunk size (in MB)
TUS_CHUNK_SIZE_MB=8
