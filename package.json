{
  "name": "drive-to-bunny",
  "version": "1.0.0",
  "description": "Telegram bot that mirrors video files from public Google Drive folders to Bunny Stream - streamed, resumable, and memory-safe even for 10 GB videos",
  "main": "src/bot.js",
  "private": true,
  "keywords": [
    "telegram",
    "bot",
    "telegraf",
    "google-drive",
    "bunny-stream",
    "bunnycdn",
    "video",
    "automation",
    "tus"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "telegraf": "^4.16.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
